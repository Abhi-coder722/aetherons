# Kopieren nach .env und Werte anpassen. Keine echten Geheimnisse in dieses Beispiel schreiben.

# ---- Öffentlich (landen im ausgelieferten HTML; nur beim Build gelesen) ----

# Öffentliche Basis-URL der Website, ohne abschließenden Slash.
PUBLIC_SITE_URL=https://www.example.de

# Terminbuchung: direkte Calendly-Event-Links inklusive Event-Slug verwenden, nicht die Profilseite.
# Nur https://calendly.com/… wird akzeptiert. Leer = kein Buchungslink,
# und der Calendly-Abschnitt in der Datenschutzerklärung entfällt. PUBLIC_CALENDLY_URL ist der allgemeine
# Fallback. Türkisch nutzt Englisch, falls TR leer ist.
PUBLIC_CALENDLY_URL=
PUBLIC_CALENDLY_URL_DE=
PUBLIC_CALENDLY_URL_TR=
PUBLIC_CALENDLY_URL_EN=
