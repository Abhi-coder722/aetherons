# Kopieren nach .env und Werte anpassen. Keine echten Geheimnisse in dieses Beispiel schreiben.

# ---- Öffentlich (landen im ausgelieferten HTML; nur beim Build gelesen) ----

# Öffentliche Basis-URL der Website, ohne abschließenden Slash.
PUBLIC_SITE_URL=https://www.example.de

# Ziel des Anfrageformulars:
#   /api/inquiry            -> eigener Server aus server/ (Validierung + E-Mail-Zustellung, siehe unten)
#   https://…               -> externer Formular-Dienst (multipart POST; CSP/form-action anpassen)
#   (leer)                  -> kein Formular, stattdessen E-Mail-Kontakt (mailto)
PUBLIC_FORM_ENDPOINT=/api/inquiry

# Terminbuchung: direkte Calendly-Event-Links inklusive Event-Slug verwenden, nicht die Profilseite.
# Nur https://calendly.com/… wird akzeptiert. Leer = kein Buchungslink,
# und der Calendly-Abschnitt in der Datenschutzerklärung entfällt. PUBLIC_CALENDLY_URL ist der allgemeine
# Fallback. Türkisch nutzt Englisch, falls TR leer ist.
PUBLIC_CALENDLY_URL=
PUBLIC_CALENDLY_URL_DE=
PUBLIC_CALENDLY_URL_TR=
PUBLIC_CALENDLY_URL_EN=

# ---- Nur für den optionalen Server (npm run serve) – NIEMALS mit PUBLIC_ präfixen ----

PORT=8080
# Erlaubte Herkunft für Formular-Posts (Standard: PUBLIC_SITE_URL). Mehrere Werte mit Komma trennen.
ALLOWED_ORIGINS=
# true, wenn der Server hinter einem vertrauenswürdigen Reverse-Proxy läuft (X-Forwarded-For für Rate-Limit).
TRUST_PROXY=false
# Empfänger, Absender und SMTP-Zugang. SMTP_PASS gehört nur in .env/Hosting-Secrets.
INQUIRY_TO=kontakt@example.de
INQUIRY_FROM=website@example.de
SMTP_HOST=smtp.example.test
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=website@example.de
SMTP_PASS=
# Alternative Komplett-URL; "console" schreibt Mails nur in die Konsole (keine Zustellung).
SMTP_URL=
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_S=600
