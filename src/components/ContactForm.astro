---
import { LIMITS, TOPICS } from '../lib/validation';
import { getMessages, routePath } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  endpoint: string;
}
const { locale, endpoint } = Astro.props;
const t = getMessages(locale);
const f = t.form;
const successUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
successUrl.searchParams.set('sent', '1');

const clientMessages = {
  errors: f.errors,
  limits: {
    name: LIMITS.name,
    company: LIMITS.company,
    message: LIMITS.message,
    detail: LIMITS.detail,
  },
  statusSending: f.statusSending,
  statusBlocked: f.statusBlocked,
  statusFailed: f.failureTitle,
  statusSuccess: f.successTitle,
  submit: f.submit,
  submitting: f.submitting,
  messageHint: f.messageHint,
};
---

<div class="contact-form-wrap" data-contact>
  <form
    class="contact-form"
    method="post"
    action={endpoint}
    accept-charset="UTF-8"
    data-contact-form
    aria-describedby="form-required-note"
  >
    <div class="error-summary" data-error-summary tabindex="-1" hidden>
      <h2 class="error-summary-title">{f.errorSummaryTitle}</h2>
      <ul data-error-list></ul>
    </div>

    <p id="form-required-note" class="required-note">
      {f.requiredNote.split('{star}')[0]}
      <span aria-hidden="true">*</span>
      <span class="visually-hidden"> {f.requiredSr}</span>
      {f.requiredNote.split('{star}')[1]}
    </p>

    <fieldset class="field topic-field">
      <legend>
        {f.topicLegend} <span class="optional">{f.optional}</span>
      </legend>
      <p class="field-hint" id="topic-hint">
        {f.topicHint}
      </p>
      <div class="choices" aria-describedby="topic-hint">
        {TOPICS.map((topic) => (
          <label class="choice" for={`topic-${topic}`}>
            <input id={`topic-${topic}`} type="radio" name="topic" value={topic} />
            <span>
              <span class="choice-label">{f.topics[topic].label}</span>
              <span class="choice-hint">{f.topics[topic].hint}</span>
            </span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="field">
      <label for="name">
        {f.name} <span aria-hidden="true">*</span>
      </label>
      <input
        id="name"
        name="name"
        type="text"
        autocomplete="name"
        required
        maxlength={LIMITS.name}
        aria-describedby="name-error"
      />
      <p class="field-error" id="name-error" data-error-for="name" hidden></p>
    </div>

    <div class="field">
      <label for="email">
        {f.email} <span aria-hidden="true">*</span>
      </label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        spellcheck="false"
        required
        maxlength={LIMITS.email}
        aria-describedby="email-hint email-error"
      />
      <p class="field-hint" id="email-hint">
        {f.emailHint}
      </p>
      <p class="field-error" id="email-error" data-error-for="email" hidden></p>
    </div>

    <div class="field">
      <label for="company">
        {f.company} <span class="optional">{f.optional}</span>
      </label>
      <input
        id="company"
        name="company"
        type="text"
        autocomplete="organization"
        maxlength={LIMITS.company}
        aria-describedby="company-error"
      />
      <p class="field-error" id="company-error" data-error-for="company" hidden></p>
    </div>

    <div class="topic-group" data-topic-group="website">
      <div class="field">
        <label for="url">
          {f.details.website.url} <span class="optional">{f.optional}</span>
        </label>
        <input
          id="url"
          name="url"
          type="text"
          inputmode="url"
          autocomplete="url"
          spellcheck="false"
          maxlength={LIMITS.url}
          aria-describedby="url-hint url-error"
        />
        <p class="field-hint" id="url-hint">
          {f.details.website.urlHint}
        </p>
        <p class="field-error" id="url-error" data-error-for="url" hidden></p>
      </div>
    </div>

    <div class="topic-group" data-topic-group="shop">
      <div class="field">
        <label for="shopContext">
          {f.details.shop.context} <span class="optional">{f.optional}</span>
        </label>
        <input
          id="shopContext"
          name="shopContext"
          type="text"
          maxlength={LIMITS.detail}
          aria-describedby="shopContext-hint shopContext-error"
        />
        <p class="field-hint" id="shopContext-hint">
          {f.details.shop.contextHint}
        </p>
        <p class="field-error" id="shopContext-error" data-error-for="shopContext" hidden></p>
      </div>
    </div>

    <fieldset class="field topic-group" data-topic-group="pos">
      <legend>
        {f.details.pos.legend} <span class="optional">{f.optional}</span>
      </legend>
      <p class="field-hint" id="pos-hint">
        {f.details.pos.hint}
      </p>
      <div class="pos-grid">
        <div class="field">
          <label for="posProvider">{f.details.pos.provider}</label>
          <input
            id="posProvider"
            name="posProvider"
            type="text"
            maxlength={LIMITS.detail}
            aria-describedby="pos-hint posProvider-error"
          />
          <p class="field-error" id="posProvider-error" data-error-for="posProvider" hidden></p>
        </div>
        <div class="field">
          <label for="posModel">{f.details.pos.model}</label>
          <input
            id="posModel"
            name="posModel"
            type="text"
            maxlength={LIMITS.detail}
            aria-describedby="pos-hint posModel-error"
          />
          <p class="field-error" id="posModel-error" data-error-for="posModel" hidden></p>
        </div>
        <div class="field">
          <label for="posVersion">{f.details.pos.version}</label>
          <input
            id="posVersion"
            name="posVersion"
            type="text"
            maxlength={LIMITS.detail}
            aria-describedby="pos-hint posVersion-error"
          />
          <p class="field-error" id="posVersion-error" data-error-for="posVersion" hidden></p>
        </div>
      </div>
    </fieldset>

    <div class="topic-group" data-topic-group="data">
      <div class="field">
        <label for="dataTools">
          {f.details.data.tools} <span class="optional">{f.optional}</span>
        </label>
        <input
          id="dataTools"
          name="dataTools"
          type="text"
          maxlength={LIMITS.detail}
          aria-describedby="dataTools-hint dataTools-error"
        />
        <p class="field-hint" id="dataTools-hint">
          {f.details.data.toolsHint}
        </p>
        <p class="field-error" id="dataTools-error" data-error-for="dataTools" hidden></p>
      </div>
    </div>

    <div class="field">
      <label for="message">
        {f.message} <span aria-hidden="true">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="7"
        required
        minlength={LIMITS.messageMin}
        maxlength={LIMITS.message}
        aria-describedby="message-hint message-error"
      ></textarea>
      <p class="field-hint" id="message-hint" data-message-hint>
        {f.messageHint.unsure}
      </p>
      <p class="field-error" id="message-error" data-error-for="message" hidden></p>
    </div>

    <div class="honeypot" aria-hidden="true">
      <label for="hp-field">{f.honeypot}</label>
      <input id="hp-field" type="text" name="_honey" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="locale" value={locale} />
    <input type="hidden" name="_subject" value="aetheron – Website-Anfrage" />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_captcha" value="false" />
    <input type="hidden" name="_next" value={successUrl.toString()} />

    <div class="form-actions">
      <button class="button button--primary" type="submit" data-submit>
        <span data-submit-label>{f.submit}</span>
        <span class="arrow" aria-hidden="true">
          →
        </span>
      </button>
      <p class="privacy-note">
        {f.privacyNote}{' '}
        <a href={`${routePath('privacy', locale)}#kontaktformular`}>{f.privacyLink}</a>.
      </p>
    </div>

    <div class="form-status" role="status" aria-live="polite" data-status></div>
  </form>

  <iframe name="contact-submit-result" title="" data-submit-frame hidden></iframe>

  <div class="form-result form-result--error" data-failure hidden tabindex="-1">
    <h2>{f.failureTitle}</h2>
    <p>{f.failureText}</p>
    <p>
      <a class="button button--secondary" href="#" data-mail-fallback>
        {f.mailButton}
      </a>
    </p>
  </div>

  <script type="application/json" data-form-i18n set:html={JSON.stringify(clientMessages)} />
</div>

<script>
  import {
    validateInquiry,
    normalizeInquiry,
    errorMax,
    TOPICS,
    type InquiryField,
    type InquiryInput,
    type Topic,
  } from '../lib/validation';

  const root = document.querySelector<HTMLElement>('[data-contact]');
  const form = root?.querySelector<HTMLFormElement>('[data-contact-form]');

  if (root && form) {
    const i18n = JSON.parse(root.querySelector('[data-form-i18n]')!.textContent || '{}');
    form.noValidate = true;
    const summary = form.querySelector<HTMLElement>('[data-error-summary]')!;
    const summaryList = form.querySelector<HTMLUListElement>('[data-error-list]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const submitFrame = root.querySelector<HTMLIFrameElement>('[data-submit-frame]')!;
    const hint = form.querySelector<HTMLElement>('[data-message-hint]')!;
    const groups = Array.from(form.querySelectorAll<HTMLElement>('[data-topic-group]'));
    const fieldNames: InquiryField[] = [
      'name',
      'email',
      'company',
      'message',
      'url',
      'shopContext',
      'posProvider',
      'posModel',
      'posVersion',
      'dataTools',
    ];

    const read = (): InquiryInput => {
      const data: Record<string, string> = {};
      new FormData(form).forEach((value, key) => {
        if (typeof value === 'string') data[key] = value;
      });
      return normalizeInquiry(data);
    };

    const messageFor = (code: string) =>
      (i18n.errors[code] as string).replace(
        '{max}',
        String(errorMax[code as keyof typeof errorMax] ?? ''),
      );

    const showFieldError = (field: InquiryField, code?: string) => {
      const input = form.elements.namedItem(field) as HTMLElement | null;
      const error = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
      if (!input || !error) return;
      if (code) {
        input.setAttribute('aria-invalid', 'true');
        error.textContent = messageFor(code);
        error.hidden = false;
      } else {
        input.removeAttribute('aria-invalid');
        error.textContent = '';
        error.hidden = true;
      }
    };

    // Themenabhängige Felder: nur die zum gewählten Thema passende Gruppe zeigen.
    // Ohne JavaScript bleiben alle (freiwilligen) Gruppen sichtbar.
    const applyTopic = (topic: Topic) => {
      groups.forEach((group) => {
        group.hidden = group.dataset.topicGroup !== topic;
      });
      hint.textContent = i18n.messageHint[topic] ?? i18n.messageHint.unsure;
    };
    const current = (): Topic =>
      (form.querySelector<HTMLInputElement>('input[name="topic"]:checked')?.value as Topic) ||
      'unsure';

    form
      .querySelectorAll<HTMLInputElement>('input[name="topic"]')
      .forEach((radio) => radio.addEventListener('change', () => applyTopic(current())));

    const preset = new URLSearchParams(location.search).get('topic');
    if (preset && (TOPICS as readonly string[]).includes(preset)) {
      const radio = form.querySelector<HTMLInputElement>(`#topic-${preset}`);
      if (radio) radio.checked = true;
    }
    applyTopic(current());

    fieldNames.forEach((field) => {
      const input = form.elements.namedItem(field) as HTMLElement | null;
      input?.addEventListener('blur', () => {
        if (input.getAttribute('aria-invalid') === 'true') {
          showFieldError(field, validateInquiry(read())[field]);
        }
      });
    });

    const setBusy = (busy: boolean) => {
      submit.disabled = busy;
      form.setAttribute('aria-busy', String(busy));
      submitLabel.textContent = busy ? i18n.submitting : i18n.submit;
    };

    let submissionPending = false;
    form.target = submitFrame.name;

    submitFrame.addEventListener('load', () => {
      if (!submissionPending) return;

      let delivered = false;
      try {
        const resultUrl = new URL(submitFrame.contentWindow?.location.href ?? '');
        delivered =
          resultUrl.origin === location.origin && resultUrl.searchParams.get('sent') === '1';
      } catch {
        // A FormSubmit error page remains cross-origin; only our _next page proves delivery.
      }

      submissionPending = false;
      setBusy(false);
      status.dataset.state = delivered ? 'success' : 'error';
      status.textContent = delivered ? i18n.statusSuccess : i18n.statusFailed;

      if (delivered) {
        form.reset();
        applyTopic('unsure');
      }
    });

    form.addEventListener('submit', (event) => {
      const input = read();
      const errors = validateInquiry(input);
      fieldNames.forEach((field) => showFieldError(field, errors[field]));
      const invalid = fieldNames.filter((field) => errors[field]);

      if (invalid.length > 0) {
        event.preventDefault();
        summaryList.replaceChildren(
          ...invalid.map((field) => {
            const li = document.createElement('li');
            const link = document.createElement('a');
            link.href = `#${field}`;
            link.textContent = messageFor(errors[field]!);
            link.addEventListener('click', (e) => {
              e.preventDefault();
              (form.elements.namedItem(field) as HTMLElement | null)?.focus();
            });
            li.append(link);
            return li;
          }),
        );
        summary.hidden = false;
        summary.focus();
        return;
      }
      summary.hidden = true;

      // Honeypot ausgefüllt: vermutlich automatisiert – nicht senden, keinen Erfolg vortäuschen.
      const honeypot = form.querySelector<HTMLInputElement>('#hp-field');
      if (honeypot && honeypot.value) {
        event.preventDefault();
        status.textContent = i18n.statusBlocked;
        return;
      }

      setBusy(true);
      status.dataset.state = 'sending';
      status.textContent = i18n.statusSending;
      submissionPending = true;
    });
  }
</script>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-5);
  }

  .required-note {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .field {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  label,
  legend {
    font-weight: 600;
  }

  legend {
    padding: 0;
    margin-bottom: var(--space-2);
  }

  .optional {
    font-weight: 400;
    color: var(--color-ink-muted);
  }

  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    border: 1.5px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    transition: border-color 0.15s var(--ease);
  }

  textarea {
    resize: vertical;
    min-height: 10rem;
  }

  input:hover,
  textarea:hover {
    border-color: var(--color-ink-muted);
  }

  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--color-primary);
    outline-offset: 1px;
  }

  [aria-invalid='true'] {
    border-color: var(--color-error) !important;
  }

  .field-hint {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .field-error {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-error);
  }

  .field-error::before {
    content: '!';
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.1rem;
    border-radius: 50%;
    background: var(--color-error);
    color: #fff;
    font-size: 0.75rem;
  }

  .choices {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }

  .choice {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding: 0.7rem 0.9rem;
    border: 1.5px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    cursor: pointer;
  }

  .choice input {
    width: 1.15rem;
    height: 1.15rem;
    margin: 0.2rem 0 0;
    flex: none;
    accent-color: var(--color-primary);
  }

  .choice-label {
    display: block;
    font-weight: 600;
  }

  .choice-hint {
    display: block;
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-ink-muted);
  }

  .choice:has(input:checked) {
    border-color: var(--color-primary);
    background: var(--color-tint);
  }

  .choice:has(input:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .topic-group {
    padding: 0;
    margin: 0;
    border: 0;
    min-width: 0;
  }

  .pos-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 40em) {
    .pos-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-actions {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .privacy-note {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    max-width: 36rem;
  }

  .form-status:empty {
    display: none;
  }

  .form-status {
    font-weight: 600;
  }

  .form-status[data-state='success'] {
    color: var(--color-success);
  }

  .form-status[data-state='error'] {
    color: var(--color-error);
  }

  .error-summary,
  .form-result {
    padding: var(--space-5);
    border-radius: var(--radius);
    border-left: 6px solid;
  }

  .error-summary {
    background: var(--color-error-bg);
    border-color: var(--color-error);
  }

  .error-summary-title {
    font-size: var(--text-lg);
    color: var(--color-error);
    margin-bottom: var(--space-2);
  }

  .error-summary ul {
    padding-left: 1.2rem;
  }

  .error-summary a {
    color: var(--color-error);
    font-weight: 600;
  }

  .form-result {
    display: grid;
    gap: var(--space-3);
  }

  .form-result[hidden] {
    display: none;
  }

  .form-result h2 {
    font-size: var(--text-xl);
  }

  .form-result--error {
    margin-top: var(--space-5);
    background: var(--color-error-bg);
    border-color: var(--color-error);
  }
</style>
