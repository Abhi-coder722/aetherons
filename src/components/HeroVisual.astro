---
/**
 * Illustration im Hero: verstreute Ausgangslagen laufen – wie der Strich im
 * Logo – zu einem mintgrünen Ergebnis zusammen. Rein dekorativ.
 */
const inputs = ['Anfragen per E-Mail', 'Excel-Listen', 'Doppelte Eingaben'];
const ys = [60, 190, 320];
---

<figure class="hero-visual" aria-hidden="true">
  <svg viewBox="0 0 520 380" focusable="false">
    <g class="lines">
      <path pathLength="1" d="M210 60H258Q290 60 290 92V158Q290 190 322 190H420" />
      <path pathLength="1" d="M210 190H420" />
      <path pathLength="1" d="M210 320H258Q290 320 290 288V222Q290 190 322 190H420" />
    </g>
    {inputs.map((label, index) => (
      <g class="chip">
        <rect x="1" y={ys[index] - 29} width="208" height="58" rx="12" />
        <text x="24" y={ys[index] + 6}>
          {label}
        </text>
      </g>
    ))}
    <rect class="result" x="420" y="162" width="56" height="56" />
    <text class="result-label" x="448" y="252" text-anchor="middle">
      Klarer Ablauf
    </text>
  </svg>
</figure>

<style>
  .hero-visual {
    margin: 0;
    width: 100%;
    max-width: 34rem;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .lines path {
    fill: none;
    stroke: var(--logo-blue);
    stroke-width: 8;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: draw 1.4s var(--ease) both;
  }

  .lines path:nth-child(2) {
    animation-delay: 0.15s;
  }

  .lines path:nth-child(3) {
    animation-delay: 0.3s;
  }

  .chip rect {
    fill: var(--color-night-raised);
    stroke: var(--color-night-line);
    stroke-width: 2;
  }

  .chip text {
    fill: var(--color-on-night-soft);
    font-family: var(--font-body);
    font-size: 17px;
  }

  .result {
    fill: var(--logo-mint);
    transform-origin: 448px 190px;
    animation: pop 0.5s 1.2s var(--ease) both;
  }

  .result-label {
    fill: var(--color-mint);
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes pop {
    from {
      transform: scale(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lines path,
    .result {
      animation: none;
    }
  }
</style>
