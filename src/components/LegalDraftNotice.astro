---
import { getMessages } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getMessages(locale);
---

<div class="legal-notice" role="note">
  <p>
    <strong>{t.legal.draftTitle}</strong>
  </p>
  <p>{t.legal.draftText}</p>
  {t.legal.translationNote && <p>{t.legal.translationNote}</p>}
  <p class="legal-meta">
    {t.legal.authoritative} · {t.legal.reviewStatus}: {t.legal.notReviewed}
  </p>
</div>

<style>
  .legal-notice {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    margin-bottom: var(--space-7);
    border: 2px dashed #a57c00;
    border-radius: var(--radius);
    background: #fffaf0;
    color: #5c4300;
  }

  .legal-meta {
    font-size: var(--text-sm);
  }
</style>
