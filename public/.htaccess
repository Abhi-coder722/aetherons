# Für Apache-Hosting (z. B. viele deutsche Shared-Hoster). Wird bei anderen Servern ignoriert.
# Das Kontaktformular sendet per HTTPS an FormSubmit.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS erzwingen
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Frühere Adressen (v2) dauerhaft umleiten
  RewriteRule ^leistungen/?$ / [L,R=301]
  RewriteRule ^leistungen/websites/?$ /webentwicklung/ [L,R=301]
  RewriteRule ^leistungen/daten-und-automatisierung/?$ /daten-digitalisierung/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' https://formsubmit.co; frame-src 'self' https://formsubmit.co; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(woff2?|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
