{
  "name": "aetheron-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Website von aetheron – Webentwicklung, Online-Shops, Kassensystem-Anbindung und Daten & Digitalisierung (de/tr/en).",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.ts",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run check && npm run test && npm run build && npm run test:e2e",
    "check:launch": "node --env-file-if-exists=.env scripts/check-launch.mjs",
    "assets": "node scripts/generate-brand-assets.mjs",
    "serve": "node --env-file-if-exists=.env server/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.3.5",
    "nodemailer": "^10.0.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
